+local function houseKey(sh)
+    return sh:getX() .. "," .. sh:getY() .. "," .. sh:getW() .. "," .. sh:getH()
+end
+local function findHouse(args)
+    if type(args) ~= "table" then return nil end
+    local found
+    local list = SafeHouse.getSafehouseList()
+    for i = 0, list:size() - 1 do
+        local sh = list:get(i)
+        if args.id and houseKey(sh) == args.id then return sh end
+        if not args.id and sh:getTitle() == args.title then
+            -- Old clients may use a title only when it uniquely identifies a house.
+            if found then return nil end
+            found = sh
+        end
+    end
+    return found
+end
