+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    validate=function(self)
+        local data=self.obj and self.obj:getModData().movableData
+        local invention=data and data.inventionData
+        return ATFRewards.near(self.character,self.obj) and invention and invention.isBroken and type(invention.repairList)=="table" and ATFRewards.hasRequirements(self.character,invention.repairList) and ATFRewards.hasTool(self.character,"Screwdriver")
+    end,
+    initialize=function(self,state)
+        self.itemList=self.obj:getModData().movableData.inventionData.repairList
+        state.duration=200/(math.max(1,self.character:getPerkLevel(Perks.Maintenance))/10)
+    end,
+    completion=function(self) LSUtil.giveXP(self.character,"Maintenance",5) end,
+    minimum=function(self,state) return state.duration*0.24 end,
+}
+function LSFixAction:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function LSFixAction:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = LSFixAction.complete
+function LSFixAction:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
