+
+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    interval=15,
+    validate=function(self) return ATFRewards.near(self.character,self.easel) and ATFRewards.artwork(self.easel,"painting") and ATFRewards.owns(self.character,self.paintItems.brush) and self.paintItems.brush:getType()=="oldPaintBrush" and ATFRewards.owns(self.character,self.paintItems.palette) and self.paintItems.palette:getType()=="paintPalette" end,
+    initialize=function(self,state) self.painting=self.easel:getModData().painting; state.duration=self.easel:getModData().progress end,
+    periodic=function(self) adjustStats(self.character,self.painting,{0,4}) end,
+    completion=function(self) adjustStats(self.character,self.painting,{50,150}) end,
+    minimum=function(self,state) return math.max(1,state.duration or 1)*0.24 end,
+}
+function LSCanvasPaintingAction:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function LSCanvasPaintingAction:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = LSCanvasPaintingAction.complete
+function LSCanvasPaintingAction:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
