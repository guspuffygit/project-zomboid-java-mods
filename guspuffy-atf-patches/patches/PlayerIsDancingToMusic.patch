+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    interval=120,
+    validate=function(self) return not self.character:isAiming() end,
+    periodic=function(self) adjustStats(self.character) end,
+}
+function PlayerIsDancingToMusic:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function PlayerIsDancingToMusic:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = PlayerIsDancingToMusic.complete
+function PlayerIsDancingToMusic:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
