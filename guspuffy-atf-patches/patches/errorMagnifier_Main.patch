+-- Refresh at most four times a second; final pending updates still run after parsing stops.
+local nextErrorDisplayRefresh = 0
+Events.OnTickEvenPaused.Add(function()
+    if not errorMagnifier.displayRefreshPending then return end
+    local now = getTimestampMs()
+    if now < nextErrorDisplayRefresh then return end
+    nextErrorDisplayRefresh = now + 250
+    errorMagnifier.displayRefreshPending = false
+    if errorMagnifier.MainWindow.instance and errorMagnifier.MainWindow.instance:isVisible()
+        and errorMagnifier.currentTab == "errors" then errorMagnifier.refreshErrorDisplay() end
