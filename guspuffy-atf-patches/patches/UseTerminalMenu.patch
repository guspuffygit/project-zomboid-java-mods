+local pendingEjections = {}
+local ejectCallback
+local function sendTerminalRequest(player, terminal, command, extra)
+    local square = terminal:getSquare()
+    if not square then return end
+    local current = player:getCurrentSquare()
+    if current and current:getZ() == square:getZ()
+        and (current == square or current:isAdjacentTo(square)) then
+        extra.x, extra.y, extra.z = square:getX(), square:getY(), square:getZ()
+        extra.index = terminal:getObjectIndex()
+        sendClientCommand(player, "TMRadio", command, extra)
+        return
+    end
+    -- walkToFront queued the walk; issue only once it actually reaches the terminal.
+    pendingEjections[player] = { terminal = terminal, command = command, extra = extra,
+        deadline = getTimestampMs() + 10000 }
+    if not ejectCallback then
+        ejectCallback = function(actor)
+            for pendingActor, pending in pairs(pendingEjections) do
+                local target = pending.terminal:getSquare()
+                local here = pendingActor:getCurrentSquare()
+                if pendingActor:isDead() or not target or getTimestampMs() >= pending.deadline then
+                    pendingEjections[pendingActor] = nil
+                elseif actor == pendingActor and here and here:getZ() == target:getZ()
+                    and (here == target or here:isAdjacentTo(target)) then
+                    pendingEjections[pendingActor] = nil
+                    sendTerminalRequest(pendingActor, pending.terminal, pending.command, pending.extra)
+                end
+            end
+            local hasPending = false
+            for _ in pairs(pendingEjections) do hasPending = true; break end
+            if not hasPending then
+                Events.OnPlayerUpdate.Remove(ejectCallback)
+                ejectCallback = nil
+            end
+        end
+        Events.OnPlayerUpdate.Add(ejectCallback)
+    end
 end
 
