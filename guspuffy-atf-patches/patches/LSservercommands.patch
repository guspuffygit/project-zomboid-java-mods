+LS_Commands["ATF_AdminXP"] = function(player, arg)
+    local policy = ATFPatches_LifestyleSyncPolicy
+    -- Preserve the provider's staff-only 500 XP diagnostic controls.
+    local perkName, xp = arg[1], arg[2]
