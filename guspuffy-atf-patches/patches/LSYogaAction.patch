+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    validate=function(self) return not self.character:isSitOnGround() and (not SandboxVars.Yoga.RequiresMat or getYogaMat(self.character)) end,
+    initialize=function(self,state)
+        self.skillLevel=ATFRewards.getHiddenLevel(self.character,"Yoga")
+        local values=ATFRewards.yogaValues(self.skillLevel)
+        self.baseFailChance,self.efficiency,self.poseLimit=values[2],values[3],values[4]
+        self.actionTable=getActionTable(self.skillLevel,{})
+        self.bonus=getTotalEfficiency(self.efficiency,{(SandboxVars.Yoga.AidObjects and getYogaMat(self.character)) and 1 or 0,0})
+        self.gainedXP,self.poseCount=0,0
+        if self.playerData.LSMoodles.WasTaughtSkill.Value>=0.2 and self.playerData.WasTaughtLast=="Yoga" then self.XPmultipliers.Yoga=self.XPmultipliers.Yoga+3 end
+        state.nextPose=state.started+330
+        state.parent=false
+    end,
+    pose=function(self,state,name)
+        if type(name)~="string" or state.pendingPose then return false end
+        local allowed=false
+        for _,value in ipairs(self.actionTable) do if value==name then allowed=true; break; end end
+        if not allowed or name==state.lastPose or (state.parent and state.parent~=name) or (self.poseCount>=self.poseLimit and not state.parent) then return false end
+        local vars=getInteractionArgs(name)
+        if not vars then return false end
+        local now=ATFRewards.clock()
+        if now<state.nextPose then
+            if state.nextPose-now>30 then return false end
+            state.pendingPose=name
+            return true
+        end
+        self.animVars=vars
+        state.lastPose=name
+        state.parent=self.animVars.parent
+        self.poseCount=self.poseCount+1
+        state.nextPose=state.started+(self.poseCount+1)*330
+        ATFRewards.award(self.character,ATFRewards.calculate(self,function(action) action:grantXP() end))
+        self.skillLevel=ATFRewards.getHiddenLevel(self.character,"Yoga")
+        return true
+    end,
+    completion=function(self) self:grantBonusXP() end,
+    completionGrace=30,
+    minimum=function(self,state) return self.poseCount>0 and (state.nextPose-state.started+220) or math.huge end,
+    cancel=function(self) self:reduceXP() end,
+}
+function LSYogaAction:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function LSYogaAction:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = LSYogaAction.complete
+function LSYogaAction:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
