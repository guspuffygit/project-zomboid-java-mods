+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    interval=120,
+    validate=function(self) return ATFRewards.instrument(self) and ATFRewards.track(self,self.instrumentType) end,
+    initialize=function(self) self.trackLevel=ATFRewards.trackLevel(self.soundFile,self.instrumentType) end,
+    periodic=function(self) adjustStats(self.character,self.trackLevel,false) end,
+    completion=function(self) adjustStats(self.character,self.trackLevel,false) end,
+    minimum=function() return 120 end,
+}
+function PlayInstrumentActionNew:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function PlayInstrumentActionNew:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = PlayInstrumentActionNew.complete
+function PlayInstrumentActionNew:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
