+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    interval=60,
+    validate=function(self) return ATFRewards.instrument(self) end,
+    initialize=function(self) self.playerLevel=self.character:getPerkLevel(Perks.Music) end,
+    periodic=function(self) adjustStats(self.character,self.playerLevel) end,
+    completion=function(self) adjustStats(self.character,self.playerLevel) end,
+    minimum=function() return 60 end,
+}
+function PlayInstrumentTraining:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function PlayInstrumentTraining:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = PlayInstrumentTraining.complete
+function PlayInstrumentTraining:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
