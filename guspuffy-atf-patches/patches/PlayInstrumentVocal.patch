+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    interval=120,
+    validate=function(self) return ATFRewards.near(self.character,self.mic) and self.character:getPerkLevel(Perks.Music)>=4 and ATFRewards.track(self,"Vocal") end,
+    initialize=function(self) self.level=ATFRewards.trackLevel(self.soundFile,"Vocal") end,
+    periodic=function(self) adjustStats(self.character,self.level) end,
+    completion=function(self) adjustStats(self.character,self.level) end,
+    minimum=function() return 120 end,
+}
+function PlayInstrumentVocal:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function PlayInstrumentVocal:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = PlayInstrumentVocal.complete
+function PlayInstrumentVocal:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
