+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    interval=120,
+    validate=function(self) return ATFRewards.near(self.character,self.DJBooth) and ATFRewards.objectName(self.DJBooth,"Booth") end,
+    periodic=function(self) adjustStats(self.character) end,
+    completion=function(self) adjustStats(self.character) end,
+    minimum=function() return 120 end,
+}
+function PlayDJBoothAction:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function PlayDJBoothAction:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = PlayDJBoothAction.complete
+function PlayDJBoothAction:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
