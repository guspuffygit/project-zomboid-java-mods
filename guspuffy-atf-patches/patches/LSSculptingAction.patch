+
+-- Native server callbacks establish and close this action's reward context.
+local ATFRewards = require "ATFPatches_LifestyleRewards"
+local atfDefinition = {
+    interval=15,
+    validate=function(self) return ATFRewards.near(self.character,self.station) and ATFRewards.artwork(self.station,"sculpture") and ATFRewards.workItems(self.character,self.workItems,self.station:getModData().style) end,
+    initialize=function(self,state) self.artwork=self.station:getModData().sculpture; state.duration=self.station:getModData().progress end,
+    periodic=function(self) adjustStats(self.character,self.artwork,{0,4}) end,
+    completion=function(self) adjustStats(self.character,self.artwork,{50,150}) end,
+    minimum=function(self,state) return math.max(1,state.duration or 1)*0.24 end,
+}
+function LSSculptingAction:serverStart()
+    ATFRewards.start(self, atfDefinition)
+end
+function LSSculptingAction:serverStop()
+    ATFRewards.finish(self, false)
+end
+local atfOriginalComplete = LSSculptingAction.complete
+function LSSculptingAction:complete()
+    return ATFRewards.complete(self, atfOriginalComplete)
+end
